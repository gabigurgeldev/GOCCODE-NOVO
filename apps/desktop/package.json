{
  "name": "@goc/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "God of Cod — GOC Desktop. Electron application with React renderer.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "concurrently -n renderer,electron \"vite\" \"scripts\\dev-electron.bat\"",
    "dev:renderer": "vite",
    "dev:electron": "scripts\\dev-electron.bat",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist out",
    "postinstall": "electron-rebuild -f -w node-pty || exit 0"
  },
  "dependencies": {
    "@goc/ai-panel": "workspace:*",
    "@goc/editor": "workspace:*",
    "@goc/shared": "workspace:*",
    "@goc/terminal": "workspace:*",
    "@goc/theme": "workspace:*",
    "@goc/ui": "workspace:*",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^6.0.0",
    "dockview": "^7.0.0",
    "lucide-react": "^1.21.0",
    "monaco-editor": "^0.52.0",
    "node-pty": "^1.1.0",
    "react-icons": "^5.6.0",
    "zustand": "^5.0.0"
  },
  "peerDependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.0",
    "electron": "^34.0.0",
    "electron-rebuild": "^3.2.9",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.61.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "rimraf": "^6.0.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^1.0.0",
    "vite-plugin-electron-renderer": "^0.14.0"
  }
}
